@model IEnumerable<ProjectManagement2.Models.NavigationModel>
<style>
    body {
        background-color: #333333;
        color: #ffffff;
    }

    a, a:visited, a:active, svg {
        color: #3bc700 !important;
        text-decoration: none;
    }

        a:hover {
            color: #4cff00;
        }

    table {
        border-spacing: 10px;
        border-collapse: separate;
    }

    td, th {
        padding: 5px;
        white-space: nowrap;
        border-radius: 3px;
    }

    .c1 {
        background-color: #444444;
    }

    .c2 {
        background-color: #555555;
    }

    .button1 {
        color: #4cff00;
        background-color: #555555;
        border-radius: 10px;
        margin-top: 10px;
        padding: 7px;
    }

    h2 {
        color: #4cff00;
        font-family: 'Agency FB','Arial','Verdana';
        text-transform: uppercase;
        position: relative;
        background: -webkit-linear-gradient(#4cff00, #184f00);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

        h2::first-letter {
            font-size: 99px !important;
        }
</style>

@Html.Partial("~/Views/Shared/AdminMenuPartialView.cshtml")

<h2>
    <a href="/navigation/index">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-gem" viewBox="0 0 16 16">
            <path d="M3.1.7a.5.5 0 0 1 .4-.2h9a.5.5 0 0 1 .4.2l2.976 3.974c.149.185.156.45.01.644L8.4 15.3a.5.5 0 0 1-.8 0L.1 5.3a.5.5 0 0 1 0-.6zm11.386 3.785-1.806-2.41-.776 2.413zm-3.633.004.961-2.989H4.186l.963 2.995zM5.47 5.495 8 13.366l2.532-7.876zm-1.371-.999-.78-2.422-1.818 2.425zM1.499 5.5l5.113 6.817-2.192-6.82zm7.889 6.817 5.123-6.83-2.928.002z" />
        </svg>
    </a> Navigation
</h2>
<p>
    <a href="/navigation/create">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-plus" viewBox="0 0 16 16" style="color:#4cff00;">
            <path d="M8.5 6a.5.5 0 0 0-1 0v1.5H6a.5.5 0 0 0 0 1h1.5V10a.5.5 0 0 0 1 0V8.5H10a.5.5 0 0 0 0-1H8.5z" />
            <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1" />
        </svg>
        Create a new navigation item
    </a>
</p>


<table class="table">
    <tr>
        <th class="c2"></th>
        <th class="c1"></th>
        <th class="c2">
            @Html.DisplayNameFor(model => Model.Websiteid)
        </th>
        <th class="c1">
            @Html.DisplayNameFor(model => model.parentid)
        </th>
        <th class="c2">
            @Html.DisplayNameFor(model => model.name)
        </th>
        <th class="c1">
            @Html.DisplayNameFor(model => model.href)
        </th>

    </tr>

    @{ int counter = 0; }
    @foreach (var item in Model)
    {
        counter++;
        <tr>
            <td class="c2" style="min-width: 30px; text-align:center;">
                @counter
            </td>
            <td class="c1" style="min-width:80px; text-align:center;">





                <a href="/navigation/edit/@item.id" style="display:inline-block;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-gear-fill" viewBox="0 0 16 16">
                        <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z" />
                    </svg>
                </a>

                <a href="/navigation/delete/@item.id" style="display:inline-block;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                        <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                    </svg>
                </a>
            </td>
            <td class="c2">
                @Html.DisplayFor(modelItem => item.websiteid)
            </td>
            <td class="c1">
                @Html.DisplayFor(modelItem => item.parentid)
            </td>
            <td class="c2">
                @Html.DisplayFor(modelItem => item.name)
            </td>
            <td class="c1">
                @Html.DisplayFor(modelItem => item.href)
            </td>
        </tr>
    }

</table>
