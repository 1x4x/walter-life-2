<!-- Darkmode / Lightmode : start -->
<style>
    body {
        color: #000000;
        background-color: #bbbbbb;
        /*
        font-size: 25px;
        padding: 25px;
        */
    }

    .dark-mode {
        color: #ffffff;
        background-color: #333333;
    }
</style>
<script>
    // call this to switch between darkmode / lightmode
    function myFunction() {
        var element = document.body;
        element.classList.toggle("dark-mode");
    }

    function toggle(element) {
        var x = document.getElementById(element);
        if (x.style.display === "none") {
            x.style.display = "block";
        } else {
            x.style.display = "none";
        }
    }

    // set darkmode as the starting mode by calling this function 1 time when we run the page and include this file
    myFunction();
</script>
<!-- Darkmode / Lightmode : end -->