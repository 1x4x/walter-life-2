                ul#images1 {
                    margin-top: 20px;
                    overflow: scroll;
                    width: 100%;
                    height: 200px;
                }

                    ul#images1 li {
                        display: inline-block;
                        /*border-radius: 10px;*/
                        /*border: 3px solid #1dc2cf;*/
                        /*could also be set to 50% if it's just 2 li elements display: inline-block;*/
                    }

                .images1img {
                    width: 80px;
                    position: relative;
                    height: auto;
                    cursor: pointer;
                }
            </style>

            <ul id="images1">
                @if (Model.UploadedImageModels != null)
                {
                    //foreach (var item2 in Model.UploadedImageModels.Where(x => x.websiteid == 1))
                    foreach (var item2 in Model.UploadedImageModels)
                    {
                        var divname = "uploadedimage" + item2.id;
                        var copytoclipboardlink = "copytoclipboardlink" + item2.id;
                        var imagepath = "/content/upload/image/" + item2.name;
                        <li>
                            <img class="uploadedimage2" data-url="/content/upload/image/@item2.name" src="/content/upload/image/@item2.name" alt="/content/upload/image/@item2.name" />
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
