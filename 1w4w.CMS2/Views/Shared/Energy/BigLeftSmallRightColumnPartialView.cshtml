<script>
    function selectthiscolor(element, colorcounter, id, imagetextdiv, color) {
        // put a 3px black border on all colordivs
        var currentcolorid2 = "";
        for (let i = 1; i <= 15; i++) {
            currentcolorid2 = "presetcolor" + id + "x" + i;
            //document.getElementById(currentcolorid2).className = currentcolorid2;
            document.getElementById(currentcolorid2).className = "presetcolor1";
            //document.getElementById(currentcolorid2).border = "3px solid #000000";

            document.getElementById(currentcolorid2).style.borderWidth = '3px';
            document.getElementById(currentcolorid2).style.borderStyle = 'solid';
            document.getElementById(currentcolorid2).style.borderColor = '#000000';
            if (i == colorcounter) {
                console.log("--> " + currentcolorid2);
            }
            else {
                console.log(currentcolorid2);
            }

        }

        // put a 3px lightblue border on the 1 selected color
        var currentcolorid = "presetcolor" + id + "x" + colorcounter;
        document.getElementById(currentcolorid).className += " presetcolor1active";
        //document.getElementById(currentcolorid).border = "3px solid #ff00ff";
        console.log('+++ selected ' + currentcolorid);

        // set color of the imagetext to the color we clicked
        document.getElementById(imagetextdiv).style.backgroundColor = color;


        // select the correct color
        //element.style.border = "3px solid #0000FF";;
        // presetcolor1active
        //document.getElementById(element).addClass('presetcolor1active');

        //$('#tt').removeClass('className');
        //$('#tt').toggleClass('className');
    }
</script>


