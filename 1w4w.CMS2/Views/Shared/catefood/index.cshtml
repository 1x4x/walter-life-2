            <!-- ====== Menu ====== -->
            <section id="menu" class="ptb">
                <div class="container align-center">
                    <span class="suptitle">Meny</span>
                    <h2>Italiensk mat för hela familjen</h2>
                </div>
                <div class="menu-list container flex">
                    @{


                    }
                    <ul>
                        @{
                            int productcounter = 0;
                            foreach (ProjectManagement2.Models.ProductCategoryModel pcm in Model.ProductCategories)
                            {
                                var tabId = "tab" + pcm.id;
                                <li style="border-radius:10px !important;"><a href="#" data-link-id="@tabId">@pcm.name</a></li>
                                productcounter++;
                            }
                        }

                    </ul>
                </div>
                <!--/.menu-list-->
                <div class="menu-item container">

                    @{
                        int pcmcounter = 0;
                        foreach (var pcm in Model.ProductCategories)
                        {
                            var pcmname = "tab" + pcm.id;

                            <div class="item-list flex" data-tab="@pcmname">
                                @*.Where(x => x.productcategoryid == pcm.id)-->*@
                                @*foreach (ProductModel pm in list).Where(x => x.productcategoryid == pcm.id)*@
                                @foreach (var pm in new ProjectManagement2.Manager.ProductManager().GetProductListByProductCategoryId(Model.Products, pcm.id))
                                {
                                    <div class="item-product flex">
                                        <div class="item-product-img">
                                            <a class="image-popup-no-margins" href="@baseurl/images/product-big-1.jpg">
                                                <img src="@baseurl/images/product-min-1.jpg" alt="">
                                                <div class="icon-search flex">
                                                    <i class="fas fa-search-plus"></i>
                                                </div>
                                            </a>
                                        </div>

                                        <div class="item-product-text">
                                            <div class="menu-title flex">
                                                <h3>@pm.name</h3>
                                                <span>@pm.price:-</span>
                                            </div>
                                            <p>@pm.description</p>
                                            <p class="menu-ingredients">@pm.description</p>
                                        </div>
                                    </div>
                                }
                            </div>
                            pcmcounter++;
                        }
                    }
                </div>

            </section>
