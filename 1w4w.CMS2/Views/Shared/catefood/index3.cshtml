                            </div>
                            <!--/.portfolio-content-->
                        </div>
                        <!--/single-portfolio-->
                        <div class="item flex single-portfolio">
                            <div class="portfolio-img">
                                <img src="@baseurl/images/portfolio-2.jpg" alt="">
                                <a class="popup-youtube" href="http://www.youtube.com/watch?v=0O2aH4XLbto"><i class="fa-solid fa-circle-play"></i></a>
                            </div>
                            <!--/.portfolio-img-->
                            <div class="portfolio-content">
                                <h3>OFF-SITE CATERING</h3>
                                <p class="address"><i class="fa-solid fa-location-dot"></i>2900 Lapeer Rd, Port Hurons, MI 49070</p>
                                <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Aperiam quod aut quo placeat esse ratione omnis ab unde velit, incidunt magni deleniti impedit eos sed optio voluptate illum quos? Esse.</p>
