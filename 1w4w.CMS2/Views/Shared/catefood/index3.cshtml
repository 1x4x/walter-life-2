                            </div>
                            <!--/.portfolio-content-->
                        </div>
                        <!--/single-portfolio-->
                        <div class="item flex single-portfolio">
                            <div class="portfolio-img">
                                <img src="@baseurl/images/portfolio-3.jpg" alt="">
                                <a class="popup-youtube" href="http://www.youtube.com/watch?v=0O2aH4XLbto"><i class="fa-solid fa-circle-play"></i></a>
                            </div>
                            <!--/.portfolio-img-->
                            <div class="portfolio-content">
                                <h3>CORPORATE CATERING</h3>
                                <p class="address"><i class="fa-solid fa-location-dot"></i>2900 Lapeer Rd, Port Hurons, MI 49070</p>
                                <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Aperiam quod aut quo placeat esse ratione omnis ab unde velit, incidunt magni deleniti impedit eos sed optio voluptate illum quos? Esse.</p>
                                <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Id ullam unde enim voluptatem non aperiam a, atque eaque iste possimus obcaecati ut reiciendis, tempore perspiciatis hic mollitia accusantium aspernatur esse.</p>
                            </div>
                            <!--/.portfolio-content-->
                        </div>
                        <!--/single-portfolio-->
                    </div>
                    <!--/.portfolio-carousel-->
                </div>
                <!--/.wrapper-portfolio-->
            </section>
            <!-- ====== End Portfolio ====== -->
            <!-- ====== Menu ====== -->
            <section id="menu" class="ptb">
                <div class="container align-center">
                    <span class="suptitle">Meny</span>
                    <h2>Italiensk mat för hela familjen</h2>
                </div>
                <div class="menu-list container flex">
                    @{
                        
                        
                    }
                    <ul>
                        @{
                            int productcounter = 0;
                            foreach (ProjectManagement2.Models.ProductCategoryModel pcm in Model.ProductCategories)
                            {
                                var tabId = "tab" + pcm.id;

                                productcounter++;
                                <li><a href="#" data-link-id="@tabId">@pcm.name</a></li>
                            }
                        }

                    </ul>
                </div>
                <!--/.menu-list-->
                <div class="menu-item container">

                    @{
                        int pcmcounter = 0;
                        foreach (var pcm in Model.ProductCategories)
                        {
                            var pcmname = "tab" + pcm.id;

                            <div class="item-list flex" data-tab="@pcmname">

                                @foreach (var pm in Model.Products.Where(x => x.productcategoryid == pcm.id))
                                {
                                    <div class="item-product flex">
                                        <div class="item-product-img">
                                            <a class="image-popup-no-margins" href="@baseurl/images/product-big-1.jpg">
                                                <img src="@baseurl/images/product-min-1.jpg" alt="">
                                                <div class="icon-search flex">
                                                    <i class="fas fa-search-plus"></i>
                                                </div>
                                                <!--/.icon-search-->
                                            </a>
                                        </div>
                                        <!--/.item-product-img-->
                                        <div class="item-product-text">
                                            <div class="menu-title flex">
                                                <h3>@pm.name</h3>
                                                <span>@pm.price:-</span>
                                            </div>
                                            <p>@pm.description</p>
                                            <p class="menu-ingredients">@pm.description</p>
                                        </div>
                                        <!--/.item-product-text-->
                                    </div>
                                }
                            </div>
                            pcmcounter++;
                        }
                    }
                </div>

            </section>
            <!-- ====== End Menu ====== -->
            <!-- ====== Booking ====== -->
            <section id="booking" class="ptb">
                <div class="container align-center">
                    <span class="suptitle">Välkommen att</span>
                    <h2>Boka bord</h2>
                </div>
                <div class="wrapper-booking container">
                    <form method="POST">
                        <div class="wrapper-input flex" style="display:none;">
                            <input type="text" name="name" placeholder="Namn">
                            <input type="text" name="location" placeholder="Adress">
                        </div>
                        <!--/.wrapper-input-->
                        <div class="wrapper-input flex" style="display:none;">
                            <input type="text" name="phone" placeholder="Telefon">
                            <input type="text" name="email" placeholder="Epost">
                        </div>
                        <!--/.wrapper-input-->
                        <div class="wrapper-input flex" style="display:none;">
                            <input type="text" name="date" placeholder="mm-dd-yy">
                            <input type="text" name="time" placeholder="12:00">
                        </div>
                        <!--/.wrapper-input-->
                        <div class="align-center">
                            <button class="btn" id="sendbook" type="button" onclick="tel:+4687120033" style="cursor:pointer; border-radius:10px;">Ring 08-712 00 33</button>
                        </div>
                        <p class="res-booking"></p>
                    </form>
                </div>
                <!--/.wrapper-booking-->
            </section>
            <!-- ====== End Booking ====== -->
        </main>

        <footer>

            <!-- ====== Contacts ====== -->
            <div id="contacts" class="ptb">
                <div class="container">
                    <span class="suptitle">Italiensk Restaurang</span>
                    <h2>La Forchetta</h2>
                </div>
                <div class="container wrapper-contact flex">
                    <div>
                        <h3>Hitta hit</h3>
                        <p style="font-weight:bold;">La Forchetta</p>
                        <p>Pluggvägen 23 A, 135 46 Tyresö</p>
                        <ul class="social-link flex">
                            <li><a href="https://www.facebook.com/laForchettaSthlm"><i class="fa-brands fa-facebook-f"></i></a></li>
                            <li><a href="https://x.com/i/flow/login?redirect_after_login=%2Fla_forchetta"><i class="fab fa-twitter"></i></a></li>
                            <li><a href="https://www.instagram.com/LaForchetta_Sthlm"><i class="fa-brands fa-instagram"></i></a></li>
                            <li><a href="https://www.youtube.com/channel/UCiD1uX0VU5tYoQZsM41HuhQ"><i class="fa-brands fa-youtube"></i></a></li>
                        </ul>
                        <!--/.social-link-->
                    </div>
                    <div>
                        <h3>Öppettider</h3>
                        <p>Mån - Fre 11.00 - 22.00</p>
                        <p>Lör - Sön 12.00 - 22.00</p>
                    </div>
                    <div>
                        <h3>Telefon</h3>
                        <p><a href="tel:+46-87120033">+46 (8) 712-00 33</a></p>
                    </div>
                    <div>
                        <h3>Epost</h3>
                        <p><a href="info@laforchetta.se">info@laforchetta.se</a></p>
                    </div>
                </div>
                <!--/.wrapper-contact-->
            </div>
            <!-- ====== End Contacts ====== -->

            <div class="wrapper-map">
                <!--<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2918.8840785320544!2d-82.49493468465671!3d42.980715479150156!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88259e93ea837f03%3A0x9eaf24e841d574ed!2zNDIzOSBMYXBlZXIgUmQsIFBvcnQgSHVyb24sIE1JIDQ4MDYwLCDQodCo0JA!5e0!3m2!1sru!2sua!4v1640107647193!5m2!1sru!2sua" style="border: 0; filter: grayscale(100%) invert(92%) contrast(83%);" allowfullscreen="" loading="lazy"></iframe>-->
