@model ProjectManagement2.Models.LayoutViewModel

@{

    Layout = null;

    var baseurl = "/content/template/catefood";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>a</title>
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="@Model.BaseUrl/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="@Model.BaseUrl/css/style.css">
    <link rel="stylesheet" href="@Model.BaseUrl/css/responsive.css">
</head>
<body>


    <!-- ====== Preloader ====== -->
    <div id="preload">
        <img src="@Model.BaseUrl/images/preload.png" alt="">
    </div>
    <!-- ======End Preloader ====== -->

    <div class="wrapper" id="home">

        <!-- ====== Header ====== -->
        <header>
            <div class="wrapper-header container flex">
                <a id="logo" href="#home"><img src="@baseurl/images/logo3.png" alt=""></a>
                <nav id="navigation" class="flex">
                    <a id="closemenu" href="#"><i class="fa-solid fa-xmark"></i></a>
                    <ul class="menu">
                        <!--<li><a href="#home">Restaurang La Forchetta</a></li>-->
                        <li><a href="#aboutus">Take Away</a></li>
                        <li><a href="#portfolio">Portfolio</a></li>
                        <li><a href="#menu">Meny</a></li>
                        <li><a href="#services">Services</a></li>
                        <li><a href="#contacts">Kontakt</a></li>
                    </ul>
                    <!--/.menu-->
                    <ul class="social-link flex">
                        <li><a href="https://www.facebook.com/laForchettaSthlm"><i class="fab fa-facebook-f"></i></a></li>
                        <li><a href="https://x.com/i/flow/login?redirect_after_login=%2Fla_forchetta"><i class="fa-brands fa-x-twitter"></i></a></li>
                        <li><a href="https://www.instagram.com/LaForchetta_Sthlm"><i class="fab fa-instagram"></i></a></li>
                        <li><a href="https://www.youtube.com/channel/UCiD1uX0VU5tYoQZsM41HuhQ"><i class="fab fa-youtube"></i></a></li>
                        <li>
                            <a href="/website/index">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-gem" viewBox="0 0 16 16" style="color: #4cff00;">
                                    <path d="M3.1.7a.5.5 0 0 1 .4-.2h9a.5.5 0 0 1 .4.2l2.976 3.974c.149.185.156.45.01.644L8.4 15.3a.5.5 0 0 1-.8 0L.1 5.3a.5.5 0 0 1 0-.6zm11.386 3.785-1.806-2.41-.776 2.413zm-3.633.004.961-2.989H4.186l.963 2.995zM5.47 5.495 8 13.366l2.532-7.876zm-1.371-.999-.78-2.422-1.818 2.425zM1.499 5.5l5.113 6.817-2.192-6.82zm7.889 6.817 5.123-6.83-2.928.002z" />
                                </svg>
