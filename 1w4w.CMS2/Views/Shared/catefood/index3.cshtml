                </nav>
                <!--/#navigation-->
                <a id="openmenu" href="#"><i class="fa-solid fa-bars-staggered"></i></a>
            </div>
            <!--/.wrapper-header-->
        </header>
        <!-- ====== End Header ====== -->

        <main>

            <!-- ====== Header Content ====== -->
            <!--  style="border-bottom:1px solid #333333;" -->
            <div class="wrapper-header-content flex">
                <div class="header-content container">
                    <span class="suptitle">La Forchetta</span>
                    <h1>Italiensk Pizzeria  <br> & Restaurang</h1>
                    <a class="btn" href="tel:+4687120033" style="border-radius:10px; top:-10px; left:0; position:relative;">Ring 08-7120033</a>
                    <div style="display:inline-block; padding-left:20px; margin-top:7px;">
                        <span style="color:#ffffff; font-weight:bold !important;">Öppet</span> <span style="font-weight:bold;">Mån-Fre</span> 11.00-22.00, <span style="font-weight: bold;">Lör-Sön</span> 12.00-22.00<br />
                        <span style="color:#ffffff; font-weight:bold !important;">Lunch</span> <span style="font-weight:bold;">Mån-Fre</span> 11.00-14.00
                    </div>
                </div>
                <!--/.header-content-->
            </div>
            <!-- ====== End Header Content ====== -->
            <!-- ====== Services ====== -->
            <section id="services" class="ptb" style="position:relative; top:-130px; border-radius:20px;">
                <div class="container align-center" style="display:none;">
                    <span class="suptitle">Our service</span>
                    <h2>Catering for Every Taste</h2>
                </div>
                <div class="wrapper-services container flex align-center">
                    <div>
                        <img src="@baseurl/images/services-1.png" alt="">
                        <h3>Banquet Service</h3>
                        <p>Organization and hosting of banquets</p>
                    </div>
                    <div>
                        <img src="@baseurl/images/services-2.png" alt="">
                        <h3>Off-site Catering</h3>
                        <p>Catering services for events at various locations</p>
                    </div>
                    <div>
                        <img src="@baseurl/images/services-3.png" alt="">
                        <h3>Corporate Catering</h3>
                        <p>Providing meals for company employees</p>
                    </div>
                    <div>
                        <img src="@baseurl/images/services-4.png" alt="">
                        <h3>Wedding Catering</h3>
                        <p>Organization and catering for weddings</p>
                    </div>
                </div>
                <!--/.wrapper-services-->
            </section>
            <!-- ====== End Services ====== -->
            <!-- ====== About Us ====== -->
            <section id="aboutus" class="ptb">
                <div class="wrapper-aboutus container flex">
                    <div class="aboutus-img">
                        <img src="@baseurl/images/aboutus.png" alt="">
                    </div>
                    <!--/.aboutus-img-->
                    <div class="aboutus-content">
                        <span class="suptitle">Take Away</span>
                        <h2>Beställ mat för avhämtning eller hemleverans från La Forchetta</h2>
                        <p><a href="tel:+4687120033" style="color:#cccccc;">Ring 08-712 00 33</a> om du vill beställa mat för avhämtning. Se vår <a href="/pdf/Restaurang_La-Forchetta_Avhamtningsmeny_TakeAway_2024.pdf" target="_blank" style="color:#cccccc;">avhämtningsmeny</a></p>
                        <p>Det går även bra att beställa hemleverans från La Forchetta via <a href="https://www.foodora.se/restaurant/emzd/la-forchetta" target="_blank" style="color:#cccccc;">Foodora</a></p>

                    </div>
                    <!--/.aboutus-content-->
                </div>
            </section>
            <!-- ====== End About Us ====== -->
            <!-- ====== Portfolio ====== -->
            <section id="portfolio" class="ptb">
                <div class="container align-center">
                    <span class="suptitle">Portolio</span>
                    <h2>Work examples</h2>
                </div>
                <div class="wrapper-portfolio container">
                    <div class="owl-carousel owl-theme portfolio-carousel">
                        <div class="item flex single-portfolio">
                            <div class="portfolio-img">
                                <img src="@baseurl/images/portfolio-1.jpg" alt="">
                                <a class="popup-youtube" href="http://www.youtube.com/watch?v=0O2aH4XLbto"><i class="fa-solid fa-circle-play"></i></a>
                            </div>
                            <!--/.portfolio-img-->
                            <div class="portfolio-content">
                                <h3>BANQUET SERVICE</h3>
                                <p class="address"><i class="fa-solid fa-location-dot"></i>2900 Lapeer Rd, Port Hurons, MI 49070</p>
                                <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Aperiam quod aut quo placeat esse ratione omnis ab unde velit, incidunt magni deleniti impedit eos sed optio voluptate illum quos? Esse.</p>
