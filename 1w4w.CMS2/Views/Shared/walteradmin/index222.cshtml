			document.querySelector("#pushupsoutput").style.width = percentage(percent, maxpercent) + "%";
			document.querySelector("#pushupsoutputpercent").innerHTML = percentage(percent, maxpercent) + "%";
			document.querySelector("#pushupsoutputamount").innerHTML = percent;
			document.querySelector("#pushupseditcontainer").style.display = 'none';
		}
	</script>


	<script>
