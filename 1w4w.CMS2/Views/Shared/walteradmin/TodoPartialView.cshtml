<div name="todobigdiv" id="todobigdiv" style="display:none;">
    @foreach (var item in todolist.Where(x => x.hidden == 0 && x.todotype == "todobig" && x.status == "incomplete"))
    {
        var colorincomplete = "#5800ff";

        var tododate = item.tododate ?? "";
        var tododaysleft = 0;
        var monthname = "";
        var datestring = "";
        if (!string.IsNullOrEmpty(tododate))
        {
            var todoonthesedaysinmonth = item.todoonthesedaysinmonth == "";
            var tododate2 = Convert.ToDateTime(item.tododate);
            var datenow = DateTime.Now;
            //var tododaysleft = datenow.Subtract(Convert.ToDateTime(item.tododate));
            //var tododaysleft = (datenow - Convert.ToDateTime(item.tododate)).TotalDays;

            DateTime start = DateTime.Now;
            DateTime end = Convert.ToDateTime(item.tododate);

            //TimeSpan difference = end - start;
            tododaysleft = (end.Date - start.Date).Days;
            monthname = new DateTime(tododate2.Year, tododate2.Month, tododate2.Day).ToString("MMM", System.Globalization.CultureInfo.InvariantCulture).ToLower();


            datestring = Convert.ToDateTime(item.tododate).Day + monthname;
        }


        var color = _1w4w.CMS.Manager.ColorManager.GetTodoColor(item.todotype);

        if (tododaysleft >= 0)
        {
            var todoextratext = "";
            if (!string.IsNullOrEmpty(item.todoextratext))
            {
                todoextratext = "(" + item.todoextratext + ")";
            }


            <div class="col" style="width: 800px !important; height:auto; font-size:36px;">
                <div class="card radius-10">
                    <div class="card-body" style="border:3px solid @color; border-radius:10px;">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-secondary" style="color:@color !important">
                                    @Html.Raw(item.todotext) <span class="text-success">@item.todoextratext</span>
                                    @if (!string.IsNullOrEmpty(item.todoonthesedaysinmonth))
                                    {
                                        <span style="background-color:#000000;border:3px solid @color; color:#008800; z-index:10;top:-140px; position:absolute; padding:5px 10px; border-radius:30px; right:20px;"> @item.todoonthesedaysinmonth</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(tododate))
                                {
                                    <h4 class="my-1"><span style="color: #15ca20;">@datestring</span> @item.todotime</h4>
                                    if (tododaysleft > 0)
                                    {
                                        <p class="mb-0 font-18 text-danger"><i class="bx bx-error align-middle"></i> @tododaysleft days left!</p>
                                    }
                                    else if (tododaysleft == 0)
                                    {
                                        <p class="mb-0 font-18 text-danger"><i class="bx bx-error align-middle"></i> The meeting is today!</p>
                                    }
                                }


                            </div>
                            <div class="dropdown ms-auto">
                                <a class="dropdown-toggle dropdown-toggle-nocaret" href="#" data-bs-toggle="dropdown">
                                    <i class='bx bx-dots-horizontal-rounded font-22 text-option' style="color:@color !important;"></i>
                                </a>
                                <ul class="dropdown-menu">
                                    @if (item.status == "incomplete")
                                    {
                                        <li>
                                            <a class="dropdown-item" href="javascript:location.href='/todo/setstatuscomplete/@item.id';" style="color:#008800;">Set as complete</a>
                                        </li>
                                    }
                                    @if (item.status == "complete")
                                    {
                                        <li>
                                            <a class="dropdown-item" href="javascript:location.href='/todo/setstatusincomplete/@item.id';" style="color:#333333;">Set as incomplete</a>
                                        </li>
                                    }
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        @Html.Partial("~/Views/todo/updatetodo.cshtml", item);
                                        <!--<a href=""><i class='bx bx-plus-circle'></i>Update todo</a>-->
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="javascript:location.href='/todo/deletetodo/@item.id';" style="color:#ff0000;">Delete</a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        @*{
                                <div class="d-flex align-items-center">
                                    <div>
                                        <!--<p class="mb-0 text-secondary">AF Webmeeting <span class="text-success">(Psykolog Carina)</span></p>-->
                                        <h4 class="my-1"><span style="color: #15ca20;">3 juni</span> 13:30</h4>
                                        <p class="mb-0 font-18 text-danger"><i class="bx bx-error align-middle"></i> 5 dagar kvar!</p>
