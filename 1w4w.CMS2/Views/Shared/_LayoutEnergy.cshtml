                                    </td>
                                    <td style="color:@alternatingfg; background-color:@alternatingbg; padding:10px; border:1px solid #1dc2cf; border-radius:10px; vertical-align:top;">
                                        @if (Model.CateringOrderRowModels != null)
                                        {
