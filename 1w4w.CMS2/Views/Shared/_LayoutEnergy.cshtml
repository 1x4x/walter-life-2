    <div id="cateringdiv" name="cateringdiv" style="display:none;">
        <br />
        <div style="text-align:center;">
            <div class="topic12">Catering <span style="color: #1dc2cf !important;">Order</span></div>
            Här visas alla cateringordrar uppdelade i de 3 statusarna
            <u style="color: #1dc2cf !important;">Beställd</u>, <u style="color: #1dc2cf !important;">Levererad</u>, <u style="color: #1dc2cf !important;">Annullerad</u> (kan/ska ej genomföras)<br />
            <br />
            @{
                if (Model.CateringOrderModels != null)
                {
                    var orderedcount = Model.CateringOrderModels.Where(x => x.status == "ordered").Count();
                    var deliveredcount = Model.CateringOrderModels.Where(x => x.status == "delivered").Count();
                    var annulledcount = Model.CateringOrderModels.Where(x => x.status == "annulled").Count();


                    int counter = 0;
                    var alternatingbg = "";
                    var alternatingfg = "";
                    <div style="border-top: 1px solid #1dc2cf;">
                        <br />
                        <h4 style="color:#ffff00; background-color:#333333;">Beställda (@orderedcount)</h4>
                        <table style="margin:auto; margin-bottom:30px;">
                            @foreach (var item in Model.CateringOrderModels.Where(x => x.status == "ordered"))
                            {
                                var orderid = item.id;

                                counter++;
                                if (counter % 2 == 0)
                                {
                                    alternatingfg = "#ffffff";
                                    alternatingbg = "#444444";
                                }
                                else
                                {
                                    alternatingfg = "#ffffff";
                                    alternatingbg = "#222222";
                                }
                                <tr>
                                    <td style="color:@alternatingfg; background-color:@alternatingbg; padding:10px; border:1px solid #1dc2cf; border-radius:10px; vertical-align:top;">
                                        @item.id<br />
                                    </td>
                                    <td style="color:@alternatingfg; background-color:@alternatingbg; padding:10px; border:1px solid #1dc2cf; border-radius:10px; vertical-align:top;">
                                        <b style="color:@alternatingfg;">Skapad / Uppdaterad</b><br />
                                        @item.created<br />
                                        @item.updated<br />
                                    </td>
                                    <td style="color:@alternatingfg; background-color:@alternatingbg; padding:10px; border:1px solid #1dc2cf; border-radius:10px; vertical-align:top;">
                                        <b style="color:@alternatingfg;">Adress</b><br />
                                        @item.fullname<br />
                                        @item.address<br />
                                        @item.zipcode<br />
                                        @item.city<br />
                                        <br />
                                        @item.orgnr<br />
                                    </td>
                                    <td style="color:@alternatingfg; background-color:@alternatingbg; padding:10px; border:1px solid #1dc2cf; border-radius:10px; vertical-align:top;">
                                        <b style="color:@alternatingfg;">Kontakt</b><br />
                                        @item.phone<br />
                                        @item.email<br />



                                    </td>
                                    <td style="color:@alternatingfg; background-color:@alternatingbg; padding:10px; border:1px solid #1dc2cf; border-radius:10px; vertical-align:top;">
                                        @if (Model.CateringOrderRowModels != null)
                                        {
                                            foreach (var item2 in Model.CateringOrderRowModels.Where(x => x.orderid == orderid))
                                            {
                                                <b>@item2.amount x @item2.name</b><br />
                                            }
                                        }
                                    </td>
                                    <td style="color:@alternatingfg; background-color:@alternatingbg; padding:10px; border:1px solid #1dc2cf; border-radius:10px; vertical-align:top;">
                                        <a href="/cateringorder/setasdelivered/@item.id"><i class="fa-solid fa-circle-check" style="color:#00ff00;" alt="Levererad" title="Levererad"></i></a><br />
                                        <!--<a href="/cateringorder/setasannulled/@item.id"><i class="fa-solid fa-square-minus" style="color:#ffff00;" alt="Annullerad" title="Annullerad"></i></a><br />-->
                                        <!--<a href="/cateringorder/setasdeleted/@item.id"><i class="fa-solid fa-circle-xmark" style="color: #ff0000;" alt="Borttagen" title="Borttagen"></i></a><br />-->
                                        <a href="/cateringorder/setasannulled/@item.id"><i class="fa-solid fa-circle-xmark" style="color: #ff0000;" alt="Annullerad" title="Annullerad"></i></a><br />
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>


                    <div style="border-top: 1px solid #1dc2cf;">
                        <br />
                        <h4 style="color: #00ff00; background-color: #333333;">Levererade (@deliveredcount)</h4>
                        <table style="margin:auto; margin-bottom:30px;">
