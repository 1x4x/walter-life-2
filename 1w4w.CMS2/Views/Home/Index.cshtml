    <script>
        function percentage(partialValue, totalValue) {
            //return (100 * partialValue) / totalValue;
            return Math.ceil((100 * partialValue) / totalValue);
        }


        function setpercentsitups(percent, maxpercent) {
            //percent = percent > 90 ? 10 : percent + 10;
            //var maxpercent = '35';
            //document.querySelector(".progress-bar").style.width = percentage(percent, maxpercent) + "%";
            document.querySelector("#situpsoutput").style.width = percentage(percent, maxpercent) + "%";
            document.querySelector("#situpsoutputpercent").innerHTML = percentage(percent, maxpercent) + "%";
            document.querySelector("#situpsoutputamount").innerHTML = percent;
            document.querySelector("#situpseditcontainer").style.display = 'none';
        }


        function setpercentpushups(percent, maxpercent) {
            //percent = percent > 90 ? 10 : percent + 10;
            //var maxpercent = '35';
            //document.querySelector(".progress-bar").style.width = percentage(percent, maxpercent) + "%";
            document.querySelector("#pushupsoutput").style.width = percentage(percent, maxpercent) + "%";
            document.querySelector("#pushupsoutputpercent").innerHTML = percentage(percent, maxpercent) + "%";
            document.querySelector("#pushupsoutputamount").innerHTML = percent;
            document.querySelector("#pushupseditcontainer").style.display = 'none';
        }
    </script>


    <script>
        function savepushups(pushups) {
            let xhr = new XMLHttpRequest();
            //let url = 'https://jsonplaceholder.typicode.com/todos/1';
            //let url = '/api/updatepushups/' + pushups;
            let url = '/index.html?pushups=' + pushups;
            xhr.open("GET", url, true);

            xhr.onreadystatechange = function () {
                if (this.readyState == 4 && this.status == 200) {
                    console.log(this.responseText);
                }
            }
            // Sending our request
