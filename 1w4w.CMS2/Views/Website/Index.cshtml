            </td>
            <td class="c2">
                @Html.DisplayFor(modelItem => item.sociallinkfacebook)
            </td>
            <td class="c1">
                @Html.DisplayFor(modelItem => item.sociallinktwitter)
            </td>
            <td class="c2">
                @Html.DisplayFor(modelItem => item.sociallinkinstagram)
            </td>
            <td class="c1">
                @Html.DisplayFor(modelItem => item.sociallinkyoutube)
            </td>
            <td class="c2">
