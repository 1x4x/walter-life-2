@model _1w4w.CMS.Models.TodoModel
@{ 
    // generate random names for form + div
    var chars = "0123456789abcdefghijklmnopqrstuvwxyz";
    var output = new System.Text.StringBuilder();
    var random = new System.Random();

    for (int i = 0; i < 30; i++)
    {
        var randomNumber = random.Next(chars.Length);
        var randomChar = chars[randomNumber];
        output.Append(randomChar);
    }


    // the generated names
    var updateTodoForm = "UpdateTodoForm" + output;
    var UpdateTodoDiv = "UpdateTodoDiv" + output;
}
<a class="dropdown-item" href="javascript: toggle('@UpdateTodoDiv');" style="color:#ffff00;">Update</a>



<!--<div id="@UpdateTodoDiv" name="@UpdateTodoDiv" style="position: absolute; left: 0; right: 0; margin-inline: auto; width: fit-content; z-index: 50; background-color: #222222; padding: 20px; border-radius: 10px; display: none;">-->
