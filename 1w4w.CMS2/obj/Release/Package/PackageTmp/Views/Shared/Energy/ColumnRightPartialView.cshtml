                            <div style="font-size: 16px; text-align:center; margin-bottom:10px;"><!--<i class="fa-solid fa-image uploadicon1" style="margin:auto !important;"></i> -->Upload image</div>
                            <form action="/file/mupploadimage" method="post" enctype="multipart/form-data" id="@imgsettingsform" name="@imgsettingsform" style="width:100% !important;" multiple="true">
