<style>
    .uploadedimage, .uploadedfile {
        height: 100px;
        width: auto;
        border-radius: 10px;
        border: 7px solid #1dc2cf;
        outline: 2px solid #ffffff;
        cursor: pointer;
    }

        .uploadedimage:hover, .uploadedfile:hover {
            border: 7px solid #11828b;
            outline: 2px solid #1dc2cf;
        }

    /* Container holding the image and the text */
    .textstyle1 {
        color: #1dc2cf;
        font-size: 24px;
        text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
        font-weight: bold;
    }

    .textstyle2 {
        color: #ffffff;
        font-size: 14px;
        background-color: #333333;
        border: 2px solid #1dc2cf;
        border-radius: 10px;
        padding: 3px;
        padding: 0 15px;
    }

    .wwcontainer {
        display: inline-block;
        position: relative;
        text-align: center;
        margin: 20px;
    }

    /* Bottom left text */
    .wwbottom-left {
        position: relative;
        bottom: 8px;
        left: 16px;
    }

    /* Top left text */
    .wwtop-left {
        position: relative;
        top: 8px;
        left: 16px;
    }

    /* Top right text */
    .wwtop-right {
        position: relative;
        top: 8px;
        right: 16px;
    }

    /* Bottom right text */
    .wwbottom-right {
        position: relative;
        bottom: 8px;
        right: 16px;
    }

    /* Centered text */
    .wwcentered {
        position: relative;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>











