                <script>
                    var selectedWeek = document.getElementById("weekselector");

                    function showSelectedFoodies(week, weekday) {
                        var elementsToShow = document.getElementById("foodies");
                        var allFoodies = elementsToShow.getElementsByTagName("li");
                        for (var i = 0; i < allFoodies.length; i++) {
                            allFoodies[i].style.display = "none";
                        }

                        for (var i = 0; i < allFoodies.length; i++) {
                            if (allFoodies[i].getAttribute("data-week") === week &&
                                allFoodies[i].getAttribute("data-weekday") === weekday.toString()) {
                                allFoodies[i].style.display = "block";
                            }
                        }
                    }

                    const weekdays = ["monday", "tuesday", "wednesday", "thursday", "friday"];

                    function changeWeekDay(weekday) {
                        showSelectedFoodies(selectedWeek.value, weekday);
                        // Remove active class from all weekday elements

                        var elementsToShow = document.getElementById("weekdaysSelector");
                        var allWeekdays = elementsToShow.getElementsByTagName("li");

                        for (let i = 0; i < allWeekdays.length; i++) {
                            if (allWeekdays[i].getAttribute("data-weekday") === weekday.toString()) {
                                allWeekdays[i].classList.add("active");
                                allWeekdays[i].classList.remove("inactive");
                            } else {
                                allWeekdays[i].classList.remove("active");
                                allWeekdays[i].classList.add("inactive");
                            }
                        }
                    }

                    function changeWeek(selectWeek) {
                        changeWeekDay(0);
                        document.getElementById("selectedWeekHeader").textContent = "Vecka " + selectWeek.value;
                    }

                    changeWeek(selectedWeek);
                </script>



