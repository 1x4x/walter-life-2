@model _1w4w.CMS.Models.LayoutViewModel
@{
    string websiteid = System.Web.Configuration.WebConfigurationManager.AppSettings["websiteid"];
    string baseurl = "/content/energy";
    //var pageid = Request.QueryString["pageid"];
    string pageid = (string)Url.RequestContext.RouteData.Values["id"];
    if (string.IsNullOrEmpty(pageid))
    {
        pageid = "1"; // starpage
    }


    var usermodel = Model.usermodel as _1w4w.CMS.Models.UserModel;
    var accesslevel = "";
    if (usermodel != null)
    {
        accesslevel = usermodel.accesslevel ?? "";
    }
    if (pageid == null) { pageid = "1"; }
    if (pageid == "undefined") { pageid = "1"; }
    if (string.IsNullOrEmpty(pageid)) { pageid = "1"; }
    _1w4w.CMS.Models.PageModel pagemodel = Model.PageModels.Where(x => x.id == Convert.ToInt32(pageid)).SingleOrDefault();
    List<_1w4w.CMS.Models.PagePartModel> pagepartmodel = Model.PagePartModels.Where(x => x.pageid == Convert.ToInt32(pageid)).ToList();
    var list1 = Model.PagePartModels.Where(x => x.pageid == Convert.ToInt32(pageid) && x.placementid == 1);
    var list2 = Model.PagePartModels.Where(x => x.pageid == Convert.ToInt32(pageid) && x.placementid == 2);
    var count1 = list1.Count();
    var count2 = list2.Count();

    //todayslunch
    var todaysLunchModelsList = Model.TodaysLunchModels;



    // calculate weeks
    int weeksinyear = _1w4w.CMS.Manager.DateManager.GetWeeksInYear(DateTime.Now.Year);
    int week = _1w4w.CMS.Manager.DateManager.GetIso8601WeekOfYearNow();
    int nextweek = (week + 1);
    int nextnextweek = (week + 2);
    
    var nextweekexist = todaysLunchModelsList.Where(x => x.week == nextweek.ToString()).Any();
    var nextnextweekexist = todaysLunchModelsList.Where(x => x.week == nextnextweek.ToString()).Any();


}




