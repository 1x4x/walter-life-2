    //template = website.template.;
    //}
    string baseurl = template.baseurl;
    //var model1 = Model;
    //model1.



    var listincompletecountmeeting = todolist.Where(x => x.hidden == 0 && x.todotype == "meeting" && x.status == "incomplete" && (Convert.ToDateTime(x.tododate) - DateTime.Now.Date).Days >= 0).Count();
    var listincompletecounttraining = todolist.Where(x => x.hidden == 0 && x.todotype == "training" && x.status == "incomplete").Count();
    var listincompletecounthygiene = todolist.Where(x => x.hidden == 0 && x.todotype == "hygiene" && x.status == "incomplete").Count();
    var listincompletecountimportant = todolist.Where(x => x.hidden == 0 && x.todotype == "important" && x.status == "incomplete").Count();
    var listincompletecountbook = todolist.Where(x => x.hidden == 0 && x.todotype == "book" && x.status == "incomplete").Count();
    var listincompletecounttodo = todolist.Where(x => x.hidden == 0 && x.todotype == "todo" && x.status == "incomplete").Count();
