                                var currentday2 = new DateTime(DateTime.Now.Year, DateTime.Now.Month, day3);
                                var containsbothmeetingandimportantiteminsameday = todolist.Where(x => currentday2 == Convert.ToDateTime(x.tododate));
                                foreach (var item in todolist)
