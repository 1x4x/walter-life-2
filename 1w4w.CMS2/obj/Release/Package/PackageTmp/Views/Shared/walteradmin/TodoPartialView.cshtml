@foreach (var item in todolist.Where(x => x.hidden == 0 && x.todotype == "meeting" && x.status == "incomplete"))
{
    var colorincomplete = "#5800ff";

    var tododate = item.tododate;
    var todoonthesedaysinmonth = item.todoonthesedaysinmonth;

    var tododate2 = Convert.ToDateTime(item.tododate);
    var datenow = DateTime.Now;
    //var tododaysleft = datenow.Subtract(Convert.ToDateTime(item.tododate));
    //var tododaysleft = (datenow - Convert.ToDateTime(item.tododate)).TotalDays;

    DateTime start = DateTime.Now;
    DateTime end = Convert.ToDateTime(item.tododate);

    //TimeSpan difference = end - start;



    var tododaysleft = (end.Date - start.Date).Days;
    var monthname = new DateTime(tododate2.Year, tododate2.Month, tododate2.Day).ToString("MMM", System.Globalization.CultureInfo.InvariantCulture).ToLower();


    var color = _1w4w.CMS.Manager.ColorManager.GetTodoColor(item.todotype);

    if (tododaysleft >= 0)
    {
        var todoextratext = "";
        if (!string.IsNullOrEmpty(item.todoextratext))
        {
            todoextratext = "(" + item.todoextratext + ")";
        }

        <div class="col">
            <div class="card radius-10">
                <div class="card-body gradientbg" style="border:3px solid @color; border-radius:10px;">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">@item.todotext <span class="text-success">@item.todoextratext</span></p>
                            @if (!string.IsNullOrEmpty(tododate))
                            {
                                <h4 class="my-1"><span style="color: #15ca20;">@Convert.ToDateTime(item.tododate).Day @monthname</span> @item.todotime</h4>
                                if (tododaysleft > 0)
                                {
                                    <p class="mb-0 font-18 text-danger"><i class="bx bx-error align-middle"></i> @tododaysleft days left!</p>
                                }
                                else if (tododaysleft == 0)
                                {
                                    <p class="mb-0 font-18 text-danger"><i class="bx bx-error align-middle"></i> The meeting is today!</p>
