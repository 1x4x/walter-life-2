            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.status, htmlAttributes: new { @class = "control-label col-md-2" })
            <select id="status" name="status" class="form-control col-md-2">
                <option value="incomplete" style="background-color: #ff0000; color:#ffffff;">incomplete</option>
                <option value="complete" style="background-color: #008800; color:#ffffff;">complete</option>
            </select>

            @*
        @Html.LabelFor(model => model.status, htmlAttributes: new { @class = "control-label col-md-2" })
