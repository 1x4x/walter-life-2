@model _1w4w.CMS.Models.TodoModel

<style>
    #CreateTodoDiv {
        position: absolute;
        left: 0;
        right: 0;
        margin-inline: auto;
        width: fit-content;
        z-index:50;
        background-color: #222222;
        padding:20px;
        border-radius:10px;
    }
</style>
<div id="CreateTodoDiv" name="CreateTodoDiv" style="display:none;">

    @using (Ajax.BeginForm("createtodo", "todo", null, new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "CreateTodoForm555" }, htmlAttributes: new { id = "form_CreateTodoForm555" }))
    {
        @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Add Todo</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })




        <div class="form-group">
            @*Html.LabelFor(model => model.todotype, htmlAttributes: new { @class = "control-label col-md-2" })*@
            <div class="col-md-10">
                <select id="todotype" name="todotype" class="form-control col-md-2">
                    @{
                        // todotype
                        List<SelectListItem> todotypelist = new List<SelectListItem>();
                        todotypelist.Add(new SelectListItem { Text = "todo", Value = "todo" });
                        todotypelist.Add(new SelectListItem { Text = "meeting", Value = "meeting" });
                        todotypelist.Add(new SelectListItem { Text = "important", Value = "important" });
                        todotypelist.Add(new SelectListItem { Text = "training", Value = "training" });
                        todotypelist.Add(new SelectListItem { Text = "hygiene", Value = "hygiene" });
                        todotypelist.Add(new SelectListItem { Text = "book", Value = "book" });
                        ViewBag.todotypelist = todotypelist;


                        // status
                        List<SelectListItem> statuslist = new List<SelectListItem>();
                        statuslist.Add(new SelectListItem { Text = "incomplete", Value = "incomplete" });
                        statuslist.Add(new SelectListItem { Text = "complete", Value = "complete" });
                        ViewBag.status = statuslist; }

                    @*Html.DropDownListFor(model => model.todotype, (IEnumerable<SelectListItem>)ViewBag.todotypelist, new { @class = "form-control" })*@
                    @*Html.ValidationMessageFor(model => model.todotype, "", new { @class = "text-danger" })*@
                    <option value="todo" style="background-color: #555555; color:#ffffff;">todo</option>
                    <option value="meeting" style="background-color: #ffff00; color: #000000;">meeting</option>
                    <option value="important" style="background-color: #ff0000; color: #ffffff; ">important</option>
                    <option value="training" style="background-color: #165b5b; color: #ffffff; ">training</option>
                    <option value="hygiene" style="background-color: #5b165b; color: #ffffff; ">hygiene</option>
                    <option value="book" style="background-color: #ae00ff; color:#ffffff;">book</option>
                </select>
                
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.todotext, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.todotext, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.todotext, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.todoextratext, htmlAttributes: new { @class = "control-label col-md-2" })
