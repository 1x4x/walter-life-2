@{
    var systemname = "MONEYBOTZ.COM";
    //var systemname = "Beehive";
    string path = "/content/walteradmin";
}
<!DOCTYPE html>
<html lang="en" class="semi-dark">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--favicon-->
    <link rel="icon" href="@path/assets/images/favicon-32x32.png" type="image/png" />
    <!-- loader-->
    <link href="@path/assets/css/pace.min.css" rel="stylesheet" />
    <script src="@path/assets/js/pace.min.js"></script>
    <!-- Bootstrap CSS -->
    <link href="@path/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="@path/assets/css/bootstrap-extended.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link href="@path/assets/css/app.css" rel="stylesheet">
    <link href="@path/assets/css/icons.css" rel="stylesheet">
    <link href="@path/assets/css/style.css" rel="stylesheet">
    <title>@systemname</title>
</head>

<body class="" style="background-color:#333333;">
    <!-- wrapper -->
    <div class="wrapper">
        <div class="authentication-forgot d-flex align-items-center justify-content-center">
            <div class="card forgot-box">
                <div class="card-body" style="background-color: #1D1F27 !important;">
                    <div class="p-3">
                        <!--
    <div class="text-center">
        <img src="@path/assets/images/icons/forgot-2.png" width="100" alt="" />
    </div>
    -->

                        <div class="mb-3 text-center">
                            <img src="@path/assets/images/logo-icon.png" width="60" alt="" />
                        </div>

                        <div class="text-center mb-4">
                            <h5 class="" style="color:#479825;">@systemname</h5>

                            <p class="mb-0">
                                Enter your email to reset the password
                            </p>

                        </div>

                        <!--<h4 class="mt-5 font-weight-bold">Forgot Password?</h4>-->
                        <!--<p class="text-muted">Enter your email to reset the password</p>-->
                        <div class="my-4">
                            <label class="form-label" for="email">Email</label>
                            <input type="text" class="form-control" placeholder="email@email.com" id="email" name="email" />
                        </div>
                        <div class="d-grid gap-2 text-center">
                            <button type="button" class="btn btn-dark">Send</button>
                            <!--<a href="/home/login" class=""><i class='bx bx-arrow-back me-1'></i>Back to Login</a>-->

                            
                        </div>
                        <div class="d-grid gap-2 text-center">
                            
                            <br />
                            <p class="mb-0">Dont want a reset? <a href="/home/login" style="color:#00ff21;">Back to Login</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end wrapper -->
</body>
</html>