@model ProjectManagement2.Models.ProjectModel

@{
    ViewBag.Title = "Create Project";
}
<style>
    .text-box {
        background-color: #333333;
        color: #ffffff;
    }
</style>
<h2>Create Project</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.title, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.title, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.title, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.owner, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.owner, new { htmlAttributes = new { @class = "form-control", @Value = "Walter Schötz" } })
                @Html.ValidationMessageFor(model => model.owner, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.status, htmlAttributes: new { @class = "control-label col-md-2", @value = "adfd" })
            <div style="width:16px; height:16px; border-radius:10px; background-color:#ffd800; display:inline-block;" onclick="javascript:document.getElementById('status').value='unfinished';"></div>
            <div style="width:16px; height:16px; border-radius:10px; background-color:#4aa03d; display:inline-block;" onclick="javascript:document.getElementById('status').value='finished';"></div>
            <div style="width:16px; height:16px; border-radius:10px; background-color:#ff0000; display:inline-block;" onclick="javascript:document.getElementById('status').value='abandoned';"></div>
            <div class="col-md-10">
                @Html.EditorFor(model => model.status, new { htmlAttributes = new { @class = "form-control", @Value = "unfinished" } })
                @Html.ValidationMessageFor(model => model.status, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.percentcompleted, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.percentcompleted, new { htmlAttributes = new { @class = "form-control", @Value = "0" } })
                @Html.ValidationMessageFor(model => model.percentcompleted, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}
<script>
    document.getElementById("title").focus();
</script>
